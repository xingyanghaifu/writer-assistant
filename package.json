{
  "name": "writer-assistant",
  "productName": "写作副驾",
  "version": "1.3.1",
  "description": "写作副驾 - 左侧专业写作工作台 + 右侧内嵌 AI 网页（DeepSeek / ChatGPT / Claude / Gemini）",
  "main": "./out/main/index.js",
  "author": "Writer's Assistant Contributors",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/xingyanghaifu/writer-assistant",
  "repository": {
    "type": "git",
    "url": "https://github.com/xingyanghaifu/writer-assistant.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "setup:electron": "node scripts/setup-electron.mjs",
    "smoke": "node scripts/verify.mjs smoke",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist:mac": "electron-vite build && electron-builder --mac dmg zip",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage deb",
    "dist:all": "electron-vite build && electron-builder --win nsis --mac dmg zip --linux AppImage deb"
  },
  "dependencies": {
    "electron-store": "8.2.0",
    "jszip": "^3.10.1",
    "mammoth": "1.12.3",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.4.21",
    "electron": "33.4.11",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "postcss": "8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "org.writer-assistant.app",
    "productName": "写作副驾",
    "copyright": "Copyright © 2025 Writer's Assistant Contributors",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/mammoth/**",
      "**/node_modules/pdf-parse/**",
      "**/node_modules/jszip/**"
    ],
    "icon": "resources/icons/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "verifyUpdateCodeSignature": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "写作副驾",
      "deleteAppDataOnUninstall": false,
      "include": "resources/installer/installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/icon.svg",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "resources/icons/icon.svg",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.svg",
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libxss1",
        "libxtst6",
        "xauth",
        "libnss3"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
